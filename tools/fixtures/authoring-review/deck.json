              "runs": [
                {
                  "fontSize": 28,
                  "text": "① QとKの内積をスケーリングし、softmaxで重みにする。"
                }
              ]
            },
            {
              "runs": [
                {
                  "fontSize": 28,
                  "text": "② その重みでVを足し合わせ、新しい表現を作る。"
                }
              ]
            },
            {
              "runs": [
                {
                  "fontSize": 28,
                  "text": "Self-Attention：同じ入力列からQ・K・Vを作る。"
                }
              ]
            },
            {
              "runs": [
                {
                  "fontSize": 28,
                  "text": "Multi-Head：複数の投影で並列計算し、結果を結合する。"
                }

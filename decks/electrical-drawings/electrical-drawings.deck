        {
          "id": "ohm-point-head",
          "type": "text",
          "x": 92,
          "y": 696,
          "w": 584,
          "h": 32,
          "style": {
            "fontSize": 15,
            "color": "accent1",
            "lineHeight": 1.5,
            "bold": true,
            "valign": "middle"
          },
          "paragraphs": [
            {
              "runs": [

              "bullet": true
            },
            {
              "runs": [
                {
                  "text": "コイル X に電気が来ると、"
                },
                {
                  "text": "同じ名前の接点が全部いっせいに動く",
                  "bold": true
                }
              ],
              "bullet": true
            },
            {
              "runs": [
                {
                  "text": "接点は「押していない・電気が来ていない」ときの形で描く。だから a 接点は開いて、b 接点は閉じて描かれる"
                }
              ],
              "bullet": true
            },
            {
              "runs": [
                {
                  "text": "PLC(プログラマブルコントローラ)のラダー図も同じ考え方で描く"
                }
              ],
              "bullet": true
            }
          ]
        }
      ]
    },

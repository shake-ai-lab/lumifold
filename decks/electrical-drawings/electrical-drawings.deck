                  "text": "母線",
                  "bold": true
                },
                {
                  "text": ")。その間に横の行を並べて番号を付ける"
                }
              ],
              "bullet": true
            },
            {
              "runs": [
                {
                  "text": "電気は"
                },
                {
                  "text": "左から右へ",
                  "bold": true
                },
                {
                  "text": "、動作は"
                },
                {
                  "text": "上の行から下の行へ",
                  "bold": true
                },
                {
                  "text": "と読む"
                }

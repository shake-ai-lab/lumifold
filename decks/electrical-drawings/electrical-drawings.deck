          "paragraphs": [
            {
              "runs": [
                {
                  "text": "① 電源を探す",
                  "color": "accent1",
                  "bold": true
                },
                {
                  "text": "  電池・コネクタ・+5V などの記号。何ボルトで動く回路かがわかる"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "② GND をたどる",
                  "color": "accent1",
                  "bold": true
                },
                {
                  "text": "  0 V の基準。上が電源、下が GND に描くことが多い"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "③ 信号の流れを追う",
                  "color": "accent1",
                  "bold": true
                },
                {
                  "text": "  入力は左、出力は右に描くのが基本。左から右へ読む"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "④ まとまりに分ける",
                  "color": "accent1",
                  "bold": true
                },
                {
                  "text": "  電源部・入力部・制御部・出力部のように、はたらきで区切る"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "⑤ 部品の役割を考える",
                  "color": "accent1",
                  "bold": true
                },
                {
                  "text": "  「この抵抗は電流を絞る役」のように、つながりから役目を推理する"
                }
              ]
            }
          ]
        }
      ]
    },

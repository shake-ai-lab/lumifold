            "paraSpacing": 12
          },
          "paragraphs": [
            {
              "runs": [
                {
                  "text": "LED は、向きを正しくつないでも、電池に直接つなぐと一瞬で壊れます。電流を自分で制限できないからです。そこで抵抗を直列に入れて、流れる電流を決めます。"
                }
              ]
            }
          ]
        },
        {
          "id": "ohm-fig",
          "type": "image",
          "x": 64,
          "y": 306,
          "w": 640,
          "h": 236,

          "id": "ohm-math",
          "type": "math",
          "x": 64,
          "y": 548,
          "w": 640,
          "h": 84,
          "latex": "R = \\frac{V - V_f}{I} = \\frac{5.0 - 2.0}{0.010} = 300\\ \\Omega",
          "fontSize": 22,
          "displayMode": true
        },
        {
          "id": "ohm-math-cap",
          "type": "text",
          "x": 64,
          "y": 638,
          "w": 640,
          "h": 24,
          "style": {
            "fontSize": 12,
            "color": "accent5",
            "lineHeight": 1.4,
            "align": "center"
          },
          "paragraphs": [
            {
              "runs": [
                {
                  "text": "電源の電圧 V から LED の Vf を引いた残りを、抵抗が受け持つ"
                }
              ]
            }
          ]
        },
        {
          "id": "ohm-point-bg",
          "type": "shape",
          "shape": "roundRect",
          "x": 64,
          "y": 678,

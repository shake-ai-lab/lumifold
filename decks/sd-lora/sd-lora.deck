              {
                "text": "1e-4 前後（TE は凍結も）"
              },
              {
                "text": "Prodigy なら 1.0 で自動調整"
              }
            ],
            [
              {
                "text": "バッチ / 総ステップ"
              },
              {
                "text": "1〜4 / 1,000〜3,000"
              },
              {
                "text": "同程度"
              },
              {
                "text": "総数 = 枚数 × 繰り返し × エポック ÷ バッチ"
              }
            ],
            [
              {
                "text": "オプティマイザ"
              },
              {
                "text": "AdamW8bit"
              },
              {
                "text": "AdamW8bit・Adafactor"
              },
              {
                "text": "8bit は Adam の状態のメモリを約 1/4 に"
              }
            ],
            [
              {
                "text": "省メモリ"
              },
              {
                "text": "fp16/bf16・勾配チェックポイント"
              },
              {
                "text": "＋ 潜在・文章のキャッシュ"
              },
              {
                "text": "VRAM の目安 6〜8 GB ／ 12〜24 GB"
              }
            ],
            [
              {
                "text": "安定化"
              },
              {
                "text": "min-SNR γ=5・noise offset 0.05"

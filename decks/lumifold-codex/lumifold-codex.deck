            "fontSize": 11,
            "color": "accent5",
            "lineHeight": 1.4,
            "align": "center"
          },
          "paragraphs": [
            {
              "runs": [
                {
                  "text": "角 C を指先 P まで引くと、折り目は線分 CP の垂直二等分線になる"
                }
              ]
            }
          ],
          "role": "caption"
        },

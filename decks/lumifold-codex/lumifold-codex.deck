          },
          "paragraphs": [
            {
              "runs": [
                {
                  "text": "fn replace_via_temp(target, write) {"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "  let tmp = target + \".tmp\";"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "  write(&tmp)?;                         // 失敗したら tmp を消して終わり"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "  loop {"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "    match rename(&tmp, target) {"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "      Ok(()) => return Ok(()),"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "      Err(_) if attempt < 5 => sleep(50ms), // つかまれていたら待って再挑戦"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "      Err(e) => { remove(&tmp); return Err(e) }"
                }
              ]
            },
            {
              "runs": [
                {
                  "text": "} } }"
                }
              ]
            }
          ],
          "group": "atomic-code"
        },

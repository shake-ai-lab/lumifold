          "id": "fold-m2",
          "type": "math",
          "x": 64,
          "y": 390,
          "w": 640,
          "h": 60,
          "latex": "X' = X - 2\\,\\big((X - M)\\cdot\\mathbf{n}\\big)\\,\\mathbf{n}",
          "fontSize": 20,
          "color": "dk1",
          "displayMode": true
        },

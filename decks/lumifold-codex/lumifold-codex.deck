        {
          "id": "fold-m1",
          "type": "math",
          "x": 64,
          "y": 264,
          "w": 640,
          "h": 90,
          "latex": "M = \\tfrac{C + P}{2}, \\qquad \\mathbf{n} = \\dfrac{C - P}{\\lVert C - P \\rVert}",
          "fontSize": 20,
          "color": "dk1",
          "displayMode": true
        },
        {
          "id": "fold-c1",
          "type": "text",
          "x": 64,
          "y": 354,
          "w": 640,
          "h": 26,

            "lineHeight": 1.7,
            "paraSpacing": 6
          },
          "paragraphs": [
            {
              "runs": [
                {
                  "text": "紙面の中の編集 UI は拡縮を打ち消す。CSS は --ui-scale、JS は UiScaleContext。Moveable には zoom = 1/s を渡す"
                }
              ],
              "bullet": true
            },
            {
              "runs": [
                {
                  "text": "要素に付く操作バーやパネルは、紙面の中に置かない(はみ出すと切れる)。portal と position: fixed で .stage の中に置き、右パネルに重ねない(FloatingBar)"
                }
              ],
              "bullet": true
            },
            {
              "runs": [
                {
                  "text": "ボタンは mousedown で preventDefault する。編集中の文字からフォーカスを奪わない"
                }
              ],
              "bullet": true
            },
            {
              "runs": [
                {
                  "text": "見えない(opacity 0)操作部品は、pointer-events も切る。透明なボタンが、下の要素のクリックを奪わないように"
                }
              ],
              "bullet": true
            }
          ],
          "group": "uiscale-rules"
        },
        {
          "id": "uiscale-audit",
          "type": "text",
          "x": 64,
          "y": 848,
          "w": 640,
          "h": 80,
          "style": {
            "fontSize": 11.5,
            "color": "accent5",
            "lineHeight": 1.65
          },
          "paragraphs": [
            {
              "runs": [
                {
